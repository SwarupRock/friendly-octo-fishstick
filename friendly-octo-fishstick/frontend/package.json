{
  "name": "wispr-flow-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@wispr/web",
    "build": "npm run build --workspace=@wispr/web",
    "preview": "npm run preview --workspace=@wispr/web",
    "mobile": "npm run start --workspace=@wispr/mobile",
    "mobile:web": "npm run web --workspace=@wispr/mobile"
  }
}
