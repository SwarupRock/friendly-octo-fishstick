{
  "name": "svarah-ai-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@svarah/web",
    "build": "npm run build --workspace=@svarah/web",
    "preview": "npm run preview --workspace=@svarah/web",
    "mobile": "npm run start --workspace=@svarah/mobile",
    "mobile:web": "npm run web --workspace=@svarah/mobile"
  }
}
