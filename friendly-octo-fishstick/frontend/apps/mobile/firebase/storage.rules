rules_version = '2';

// Svarah.AI mobile — generated posters, voice-overs and videos, owner-only.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/campaigns/{campaignId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 60 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|audio/.*|video/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
