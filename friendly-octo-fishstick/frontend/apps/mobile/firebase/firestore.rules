rules_version = '2';

// Svarah.AI mobile — every document belongs to exactly one signed-in owner.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Profile: shop name, location, chosen voice.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // One document per offer: transcript, facts, plan, media links.
      match /campaigns/{campaignId} {
        allow read, create, update: if isOwner(uid);
        // Offers are kept as a record; the app has no delete.
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
