# Svarah.AI mobile — copy to `.env` (git-ignored) and fill in.
# Everything here is compiled into the app bundle. NEVER put a real key in this file.

# ── Agnes AI: fact extraction, validation, campaign copy, poster artwork ──
EXPO_PUBLIC_AGNES_API_BASE=https://apihub.agnes-ai.com/v1
EXPO_PUBLIC_AGNES_API_KEY=
EXPO_PUBLIC_AGNES_TEXT_MODEL=agnes-3.0-flash
EXPO_PUBLIC_AGNES_IMAGE_MODEL=agnes-image-2.5-flash

# ── Sarvam AI: speech-to-text and text-to-speech ──
EXPO_PUBLIC_SARVAM_API_BASE=https://api.sarvam.ai
EXPO_PUBLIC_SARVAM_API_KEY=
EXPO_PUBLIC_SARVAM_STT_MODEL=saaras:v4

# ── Magic Hour: AI video. One key, or several separated by commas (tried in order). ──
EXPO_PUBLIC_MAGICHOUR_API_BASE=https://api.magichour.ai
EXPO_PUBLIC_MAGICHOUR_API_KEYS=
EXPO_PUBLIC_MAGICHOUR_MODEL=default
# EXPO_PUBLIC_MAGICHOUR_RESOLUTION=720p

# ── Firebase web app config (Console → Project settings → Your apps → Web app) ──
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── Google sign-in: the Firebase project's *Web* OAuth client ID ──
# (Console → Authentication → Sign-in method → Google → Web SDK configuration.)
# The Android app's SHA-1 must also be registered under Project settings → Your apps.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
