# ── Titan — environment configuration ─────────────────────────────
# Copy to `.env` and adjust. Never commit real secrets.
# Placeholder values must stay blank/REPLACE_WITH_* — never paste secrets here.

# Runtime mode: `mock` (offline-safe, default) or `live`.
TITAN_MODE=mock

# ── Backend ───────────────────────────────────────────────────────
# SQLite for local dev/demo (Postgres-compatible schema by design).
TITAN_DATABASE_URL=sqlite:///./titan.db
# Filesystem asset store root.
TITAN_ASSETS_DIR=./assets_store
# Comma-separated allowed CORS origins for the dev frontend.
TITAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── STT ───────────────────────────────────────────────────────────
# auto | mock | sarvam | faster-whisper | none
# `auto` = mock in mock mode, Sarvam (when configured) in live mode,
# falling back to local faster-whisper, then typed input.
TITAN_STT_PROVIDER=auto
# Local fallback model (lazy-loaded on first use).
TITAN_WHISPER_MODEL=base
TITAN_WHISPER_COMPUTE_TYPE=int8

# ── Fact extraction ───────────────────────────────────────────────
# auto | mock | agnes | none
TITAN_EXTRACTION_PROVIDER=auto

# ── Fact lock (HMAC seal) ─────────────────────────────────────────
# Dedicated secret for the HMAC-SHA256 fact-lock seal and verification
# certificate. Keep separate from all provider keys. If empty, locking is
# refused safely (no unsigned "locked" facts are produced).
TITAN_SEAL_SECRET=change-me-dev-only

# ── Provider gateway ──────────────────────────────────────────────
TITAN_PROVIDER_TIMEOUT=30
TITAN_PROVIDER_MAX_RETRIES=2
TITAN_PROVIDER_BACKOFF_BASE=0.5

# ── Agnes AI (campaign brain / copywriter / localizer / poster art) ─
# Docs: https://wiki.agnes-ai.com/en/docs/agnes-30-flash  (re-check before live use)
# Text:  POST {base}/chat/completions   model agnes-3.0-flash
# Image: POST {base}/images/generations model agnes-image-2.5-flash
# Video: POST {base}/videos             model agnes-video-2.5 (async; poll)
TITAN_AGNES_API_BASE=https://apihub.agnes-ai.com/v1
TITAN_AGNES_API_KEY=
TITAN_AGNES_TEXT_MODEL=agnes-3.0-flash
TITAN_AGNES_IMAGE_MODEL=agnes-image-2.5-flash
TITAN_AGNES_VIDEO_MODEL=agnes-video-2.5
# Deterministic fallback art directory for posters when image gen is unavailable.
TITAN_POSTER_ART_FALLBACK_DIR=backend/assets/prebaked_art

# ── Sarvam AI (Saaras v4 STT + voice cloning) ───────────────────────
# Docs: https://docs.sarvam.ai  (re-check limits + schemas before live use)
TITAN_SARVAM_API_KEY=
TITAN_SARVAM_API_BASE=https://api.sarvam.ai
TITAN_SARVAM_STT_MODEL=saaras:v4

# ── Voice profiles (Phase 5A/5B) ────────────────────────────────────
# auto | mock | sarvam | none
TITAN_VOICE_PROVIDER=auto
# Voice-clip upload limits for reference audio creation.
TITAN_MAX_VOICE_SAMPLE_MB=50

# ── Media tooling (Phase 4 posters / Phase 6 video) ─────────────────
# Videos: FFmpeg is the reliable compositor core; Agnes Video is optional.
TITAN_ENABLE_AGNES_VIDEO=true
TITAN_MAX_VIDEO_JOBS_PER_CAMPAIGN=2

# ── Generation budgets (Source of Truth §50) ────────────────────────
TITAN_MAX_POSTERS=3
TITAN_MAX_VIDEO_VARIANTS=2
TITAN_MAX_VOICE_VARIANTS=5
TITAN_MAX_COPY_VARIANTS=3

# ── Durable jobs (Phase 6+) ─────────────────────────────────────────
# SQLite jobs table in mock/local mode. Cloud Tasks → Cloud Run worker only
# when a durable deployment is explicitly configured (Phase 9).
TITAN_TASKS_MODE=local
TITAN_CLOUD_PROJECT=
TITAN_CLOUD_TASKS_LOCATION=
TITAN_CLOUD_TASKS_QUEUE=
TITAN_CLOUD_RUN_WORKER_URL=

# ── Windsor.ai MCP publishing (Phase 8) ──────────────────────────────
# Docs: https://mcp.windsor.ai/llms-full.txt  (discover tools/actions live)
TITAN_WINDSOR_MCP_URL=https://mcp.windsor.ai/
TITAN_WINDSOR_AUTH_MODE=oauth
TITAN_WINDSOR_API_KEY=
TITAN_WINDSOR_CONNECTOR_CACHE_SECONDS=300

# ── Safety / feature flags ───────────────────────────────────────────
# Sabotage demo corrupts only copied fixture artifacts; rejected in live mode.
TITAN_ENABLE_DEMO_SABOTAGE=false
