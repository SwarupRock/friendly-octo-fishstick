{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "svarah-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "friendly-octo-fishstick/frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "svarah-api",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "Set-Location friendly-octo-fishstick/backend; .\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --port 8000"
      ],
      "port": 8000
    }
  ]
}
